<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/fragment_menu_main"
	android:gravity="top"
	android:layout_width="fill_parent"
	android:layout_height="fill_parent"
	android:orientation="vertical"
	android:background="@color/background_app"
	>
	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:clipToPadding="false"
		android:paddingHorizontal="16dp"
		android:paddingTop="20dp"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toTopOf="@id/version_card">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<!-- Header: welcome text + Telegram admin shortcut -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical"
				android:layout_marginBottom="22dp">

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="WELCOME BACK!"
						android:textColor="@color/primary_text"
						android:textSize="19sp"
						android:textStyle="bold"/>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="Select an option to get started"
						android:textColor="@color/secondary_text"
						android:textSize="12sp"/>
				</LinearLayout>

				<Button
					android:id="@+id/news_button"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:minWidth="0dp"
					android:minHeight="0dp"
					android:paddingHorizontal="16dp"
					android:paddingVertical="8dp"
					android:text="Telegram"
					android:textAllCaps="false"
					android:textColor="@color/card_green"
					android:textSize="13sp"
					android:background="@drawable/btn_open_green"/>
			</LinearLayout>

			<!-- Card: Custom Controls -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:background="@drawable/card_bg_green"
				android:layout_marginBottom="12dp">

				<ImageView
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:src="@drawable/ic_menu_custom_controls"/>

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="CUSTOM CONTROLS"
					android:textColor="@color/card_green"
					android:textSize="15sp"
					android:textStyle="bold"/>

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="Customize your game controls easily"
					android:textColor="@color/secondary_text"
					android:textSize="13sp"/>

				<Button
					android:id="@+id/custom_control_button"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="14dp"
					android:minWidth="0dp"
					android:minHeight="0dp"
					android:paddingHorizontal="26dp"
					android:paddingVertical="8dp"
					android:text="OPEN"
					android:textColor="@color/card_green"
					android:textSize="13sp"
					android:background="@drawable/btn_open_green"/>
			</LinearLayout>

			<!-- Card: Install Mod -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:background="@drawable/card_bg_purple"
				android:layout_marginBottom="12dp">

				<ImageView
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:src="@drawable/ic_add_modded"
					android:tint="@color/card_purple"/>

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="INSTALL MOD"
					android:textColor="@color/card_purple"
					android:textSize="15sp"
					android:textStyle="bold"/>

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="Install mods and enhance gameplay"
					android:textColor="@color/secondary_text"
					android:textSize="13sp"/>

				<Button
					android:id="@+id/discord_button"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="14dp"
					android:minWidth="0dp"
					android:minHeight="0dp"
					android:paddingHorizontal="26dp"
					android:paddingVertical="8dp"
					android:text="OPEN"
					android:textColor="@color/card_purple"
					android:textSize="13sp"
					android:background="@drawable/btn_open_purple"/>
			</LinearLayout>

			<!-- Card: Execute a .jar -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:background="@drawable/card_bg_orange"
				android:layout_marginBottom="12dp">

				<ImageView
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:src="@drawable/ic_menu_install_jar"/>

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="EXECUTE A .JAR"
					android:textColor="@color/card_orange"
					android:textSize="15sp"
					android:textStyle="bold"/>

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="Run .jar files directly"
					android:textColor="@color/secondary_text"
					android:textSize="13sp"/>

				<Button
					android:id="@+id/install_jar_button"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="14dp"
					android:minWidth="0dp"
					android:minHeight="0dp"
					android:paddingHorizontal="26dp"
					android:paddingVertical="8dp"
					android:text="OPEN"
					android:textColor="@color/card_orange"
					android:textSize="13sp"
					android:background="@drawable/btn_open_orange"/>
			</LinearLayout>

			<!-- Card: Share Log File -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:background="@drawable/card_bg_blue"
				android:layout_marginBottom="12dp">

				<ImageView
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:src="@android:drawable/ic_menu_share"
					android:tint="@color/card_blue"/>

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="SHARE LOG FILE"
					android:textColor="@color/card_blue"
					android:textSize="15sp"
					android:textStyle="bold"/>

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="Share your crash log file"
					android:textColor="@color/secondary_text"
					android:textSize="13sp"/>

				<Button
					android:id="@+id/share_logs_button"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="14dp"
					android:minWidth="0dp"
					android:minHeight="0dp"
					android:paddingHorizontal="26dp"
					android:paddingVertical="8dp"
					android:text="OPEN"
					android:textColor="@color/card_blue"
					android:textSize="13sp"
					android:background="@drawable/btn_open_blue"/>
			</LinearLayout>

			<!-- Card: Open Directory -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:background="@drawable/card_bg_yellow"
				android:layout_marginBottom="12dp">

				<ImageView
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:src="@drawable/ic_folder"/>

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="OPEN DIRECTORY"
					android:textColor="@color/card_yellow"
					android:textSize="15sp"
					android:textStyle="bold"/>

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="Open your game directory"
					android:textColor="@color/secondary_text"
					android:textSize="13sp"/>

				<Button
					android:id="@+id/open_files_button"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="14dp"
					android:minWidth="0dp"
					android:minHeight="0dp"
					android:paddingHorizontal="26dp"
					android:paddingVertical="8dp"
					android:text="OPEN"
					android:textColor="@color/card_yellow"
					android:textSize="13sp"
					android:background="@drawable/btn_open_yellow"/>
			</LinearLayout>

		</LinearLayout>
	</ScrollView>

	<!-- Select version card, pinned above the play button -->
	<LinearLayout
		android:id="@+id/version_card"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:layout_marginHorizontal="16dp"
		android:layout_marginBottom="12dp"
		app:layout_constraintBottom_toTopOf="@id/play_button">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginBottom="8dp"
			android:text="SELECT VERSION"
			android:textColor="@color/card_green"
			android:textSize="12sp"
			android:textStyle="bold"/>

		<androidx.constraintlayout.widget.ConstraintLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/card_bg_neutral">

			<com.kdt.mcgui.mcVersionSpinner
				android:id="@+id/mc_version_spinner"
				android:layout_width="0dp"
				android:layout_height="@dimen/_52sdp"
				android:background="@android:color/transparent"
				android:drawableEnd="@drawable/spinner_arrow"

				app:drawableEndSize="@dimen/padding_heavy"
				app:drawableStartIntegerScaling="true"
				app:drawableStartSize="@dimen/_36sdp"
				app:drawableEndPadding="@dimen/_1sdp"

				app:layout_constraintTop_toTopOf="parent"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toStartOf="@+id/edit_profile_button"
				app:layout_constraintStart_toStartOf="parent" />

			<ImageButton
				android:id="@+id/edit_profile_button"
				android:layout_width="@dimen/_52sdp"
				android:layout_height="@dimen/_52sdp"
				android:background="?android:attr/selectableItemBackground"

				android:src="@drawable/ic_edit_profile"
				app:layout_constraintBottom_toBottomOf="@+id/mc_version_spinner"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@+id/mc_version_spinner" />
		</androidx.constraintlayout.widget.ConstraintLayout>
	</LinearLayout>


	<!-- This view is for cosmetic purpose only -->
	<View
		android:id="@+id/_background_display_view"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:background="@color/background_bottom_bar"
		android:translationZ="-1dp"

		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintTop_toTopOf="@id/version_card" />

	<com.kdt.mcgui.MineButton
		android:id="@+id/play_button"
		android:layout_width="match_parent"
		android:layout_height="@dimen/_62sdp"

		android:layout_marginHorizontal="@dimen/_17sdp"
		android:layout_marginBottom="@dimen/_15sdp"

		android:textAllCaps="true"
		android:text="@string/main_play"
		app:layout_constraintBottom_toBottomOf="parent"
		/>

</androidx.constraintlayout.widget.ConstraintLayout>
